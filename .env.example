# Copy to a file named .env in the project root and fill in the password. .env is gitignored.
# Quarkus loads .env automatically; no quotes, no "export", no spaces around "=".
# CockroachDB Cloud speaks the PostgreSQL protocol, so the JDBC URL uses the postgresql driver.
DB_JDBC_URL=jdbc:postgresql://room-chores-35174.j77.aws-ap-south-1.cockroachlabs.cloud:26257/room_chores?sslmode=verify-full&sslrootcert=certs/root.crt
DB_USER=kiran800
DB_PASSWORD=change-me
